# ===== App =====
APP_NAME="二掌柜订舱系统"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-please-32-chars-min

# ===== Database =====
# 开发用 SQLite,生产用 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/freight.db
# 生产示例: postgresql+asyncpg://user:pass@localhost:5432/freight

# ===== Upload =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ===== OCR =====
# 留空则 OCR 走 mock 模式 (返回空数据, 仍能跑通)
PADDLEOCR_LANG=ch
PADDLEOCR_USE_GPU=false
PADDLEOCR_USE_ANGLE_CLS=true
# OCR 模型目录 (留空则用默认 ~/.paddleocr)
PADDLEOCR_MODEL_DIR=

# ===== Email / SMTP =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_NAME=二掌柜订舱
SMTP_FROM_EMAIL=ops@example.com

# ===== 定时任务 =====
# 自动拉取邮件订舱 (cron 表达式, 留空禁用)
EMAIL_POLL_CRON=

# ===== IMAP 自动拉取 SO =====
# 真实凭据: 填下面 4 项后会启用, 留空则走 mock 模式
IMAP_ENABLED=false
IMAP_HOST=imap.exmail.qq.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX
# 发件人白名单 (逗号分隔, 留空=所有)
IMAP_FILTER_FROM=booking@maersk.com,booking@msc.com
# 主题关键词 (含任一即拉, 大小写不敏感)
IMAP_FILTER_SUBJECT_KEYWORDS=SO,Booking,订舱,BL,提单
# 拉取间隔 (秒, 最少 60)
IMAP_POLL_INTERVAL_SECONDS=300
# 单次最多拉 N 封
IMAP_MAX_PER_POLL=50
# 强制 mock 模式 (即使有凭据也用本地 .eml)
IMAP_MOCK_MODE=false
# mock 目录 (存 .eml 文件)
IMAP_MOCK_DIR=./samples/imap

# ===== 船公司模板 (JSON 字符串或路径) =====
# 格式: {"MAERSK": {"so_number_regex": "...", "fields": {...}}, ...}
CARRIER_TEMPLATES_PATH=./app/data/carrier_templates.json
